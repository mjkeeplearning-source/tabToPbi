        <relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[customers].[CustomerID]' />
              <expression op='[orders].[CustomerID (Orders)]' />
            </expression>
          </clause>
          <relation connection='sqlserver.0xsvrnf1mt17ek18hdlb51drgn1y' name='customers' type='text'>SELECT [Customers].[City] AS [City],
  [Customers].[Country] AS [Country],
  [Customers].[CustomerID] AS [CustomerID],
  [Customers].[CustomerName] AS [CustomerName]
FROM [dbo].[Customers] [Customers]</relation>
          <relation connection='sqlserver.0xsvrnf1mt17ek18hdlb51drgn1y' name='orders' type='text'>SELECT [Orders].[CustomerID] AS [CustomerID (Orders)],&#13;
  [Orders].[OrderDate] AS [OrderDate],&#13;
  [Orders].[OrderID] AS [OrderID]&#13;
FROM [dbo].[Orders] [Orders]</relation>
        </relation>
