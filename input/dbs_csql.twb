        <relation connection='databricks.0h6ichl1ym51a6141q6ty1c1rmkx' name='Custom SQL Query' type='text'>SELECT&#13;
    c.address,&#13;
    c.city,&#13;
    c.continent,&#13;
    c.country,&#13;
    c.customerID,&#13;
    c.email_address,&#13;
    c.first_name,&#13;
    c.gender,&#13;
    c.last_name,&#13;
    c.phone_number,&#13;
    c.postal_zip_code,&#13;
    c.state,&#13;
    t.cardNumber,&#13;
    t.dateTime,&#13;
    t.franchiseID,&#13;
    t.paymentMethod,&#13;
    t.product,&#13;
    t.quantity,&#13;
    t.totalPrice,&#13;
    t.transactionID,&#13;
    t.unitPrice&#13;
  FROM `samples`.`bakehouse`.`sales_customers` c&#13;
  JOIN `samples`.`bakehouse`.`sales_transactions` t&#13;
    ON c.customerID = t.customerID</relation>
